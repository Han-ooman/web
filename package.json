{
  "name": "sambasku-web",
  "version": "0.1.0",
  "description": "Public web and vocabulary search for Kamus Digital Sambas-Indonesia",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "build:staging": "react-router build --mode staging",
    "preview": "react-router dev",
    "typecheck": "react-router typegen && tsc -b",
    "test": "node --experimental-strip-types --test \"app/**/*.test.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"app/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@mantine/core": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@react-router/cloudflare": "^7.18.0",
    "i18next": "^26.4.2",
    "isbot": "^5.1.23",
    "lucide-react": "^1.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^7.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.1.1",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@eslint/js": "^9.22.0",
    "@react-router/dev": "^7.18.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "wrangler": "^4.135.0"
  }
}